  {'name': 'metro-001', 'gnb_id': 1001, 'tac': '000001', 'region': 'metro', 'zone': 'edge-a', 'dense': true},
  {'name': 'metro-002', 'gnb_id': 1002, 'tac': '000002', 'region': 'metro', 'zone': 'edge-a', 'dense': true},
  {'name': 'metro-003', 'gnb_id': 1003, 'tac': '000003', 'region': 'metro', 'zone': 'edge-a', 'dense': false},
